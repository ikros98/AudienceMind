GRAPHITI_SERVICE_NAME=personagraph-graphiti
GRAPHITI_SERVICE_HOST=127.0.0.1
GRAPHITI_SERVICE_PORT=8181
GRAPHITI_SERVICE_LOG_LEVEL=INFO
GRAPHITI_SERVICE_BEARER_TOKEN=replace_with_long_random_token

GRAPHITI_SERVICE_DATA_DIR=/opt/personagraph-graphiti/data

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_neo4j_password
# Dedicated-server starting point. Increase or decrease to match host RAM.
NEO4J_HEAP_INITIAL_SIZE=2G
NEO4J_HEAP_MAX_SIZE=8G
NEO4J_PAGECACHE_SIZE=4G

# These can point to Ollama, Runpod vLLM, OpenRouter, or any other OpenAI-compatible endpoint.
GRAPHITI_LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
GRAPHITI_LLM_API_KEY=replace_with_llm_api_key
GRAPHITI_LLM_MODEL=your-chat-model
GRAPHITI_LLM_SMALL_MODEL=your-small-chat-model
GRAPHITI_LLM_TEMPERATURE=0
GRAPHITI_LLM_MAX_TOKENS=16384
GRAPHITI_LLM_FORCE_REASONING_OFF=true
GRAPHITI_LLM_REASONING_EFFORT=none

# If your chat endpoint does not expose embeddings, point these at a dedicated embedding endpoint.
GRAPHITI_EMBEDDER_BASE_URL=https://your-embedding-endpoint/v1
GRAPHITI_EMBEDDER_API_KEY=replace_with_embedding_api_key
GRAPHITI_EMBEDDING_MODEL=bge-large-en-v1.5

# `rrf` is the safest default. Only switch to cross-encoder if your provider supports it reliably.
GRAPHITI_RERANKER_BASE_URL=
GRAPHITI_RERANKER_API_KEY=
GRAPHITI_RERANKER_MODEL=
GRAPHITI_SEARCH_RERANKER=rrf

GRAPHITI_MAX_PAGE_SIZE=500
