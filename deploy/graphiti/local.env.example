# Local Graphiti service settings for this laptop.
#
# Keep the Graphiti LLM / embedder fields blank here if you want the service to inherit
# the Runpod or OpenAI-compatible endpoint settings from the repo root `.env`.
# Only fill them in here when you want this local service to override the root `.env`.

GRAPHITI_SERVICE_NAME=personagraph-graphiti-local
GRAPHITI_SERVICE_HOST=127.0.0.1
GRAPHITI_SERVICE_PORT=8182
GRAPHITI_SERVICE_LOG_LEVEL=INFO

# Leave blank to reuse GRAPHITI_API_KEY from the repo root `.env`.
GRAPHITI_SERVICE_BEARER_TOKEN=

# Local metadata store for graph IDs, ontologies, and aliases.
GRAPHITI_SERVICE_DATA_DIR=

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=personagraph-local
# Laptop-friendly defaults. Increase these on larger developer machines if needed.
NEO4J_HEAP_INITIAL_SIZE=512M
NEO4J_HEAP_MAX_SIZE=1G
NEO4J_PAGECACHE_SIZE=512M

# Leave blank to reuse the Graphiti Runpod/OpenAI settings from the repo root `.env`.
GRAPHITI_LLM_BASE_URL=
GRAPHITI_LLM_API_KEY=
GRAPHITI_LLM_MODEL=
GRAPHITI_LLM_SMALL_MODEL=
GRAPHITI_LLM_TEMPERATURE=0
GRAPHITI_LLM_MAX_TOKENS=4096
GRAPHITI_LLM_TIMEOUT_SECONDS=300
GRAPHITI_LLM_MAX_RETRIES=1
GRAPHITI_LLM_FORCE_REASONING_OFF=true
GRAPHITI_LLM_REASONING_EFFORT=

# If blank, these default to the Graphiti LLM endpoint above or the root `.env` overrides.
GRAPHITI_EMBEDDER_BASE_URL=
GRAPHITI_EMBEDDER_API_KEY=
GRAPHITI_EMBEDDING_MODEL=bge-large-en-v1.5
GRAPHITI_EMBEDDER_TIMEOUT_SECONDS=120
GRAPHITI_EMBEDDER_MAX_RETRIES=3
GRAPHITI_EMBEDDER_MAX_CONCURRENCY=2

GRAPHITI_RERANKER_BASE_URL=
GRAPHITI_RERANKER_API_KEY=
GRAPHITI_RERANKER_MODEL=
GRAPHITI_SEARCH_RERANKER=rrf

GRAPHITI_MAX_PAGE_SIZE=500
