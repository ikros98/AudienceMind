[Unit]
Description=AudienceMind Graphiti Compatibility Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=paperspace
WorkingDirectory=/opt/AudienceMind/backend
EnvironmentFile=/opt/personagraph-graphiti/service.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/AudienceMind/backend/.venv/bin/python -m uvicorn app.graphiti_service.main:app --host ${GRAPHITI_SERVICE_HOST} --port ${GRAPHITI_SERVICE_PORT}
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
