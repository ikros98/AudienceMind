# Main application LLM configuration
# Any OpenAI-compatible chat/completions endpoint should work here.
# Put your OpenRouter key here for the app and, by default, the local Graphiti service too.
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=qwen/qwen3.6-plus:free

# Optional: disable provider-side reasoning traces for local thinking models.
# Leave blank unless your provider explicitly supports this field.
LLM_REASONING_EFFORT=

# ===== Graph backend selection =====
# Use `graphiti` for the local or self-hosted Graphiti stack documented in README.md.
# Use `zep` only if you want to keep using Zep Cloud.
GRAPH_BACKEND=graphiti

# ===== Zep graph configuration =====
# Only needed when GRAPH_BACKEND=zep.
ZEP_API_KEY=your_zep_api_key_here

# ===== Graphiti client configuration =====
# These variables are used by the main AudienceMind backend.
# For local development, point this at the compatibility service running on this laptop.
GRAPHITI_BASE_URL=http://127.0.0.1:8182
GRAPHITI_API_KEY=replace_with_graphiti_bearer_token
GRAPHITI_TIMEOUT_SECONDS=300

# ===== Output language =====
# Allowed values: en, ms
OUTPUT_LANGUAGE=en

# ===== Optional Graphiti runtime overrides =====
# `deploy/graphiti/run-local-service.sh` will consume these if you set them here.
# Leave them blank if you want Graphiti to inherit `LLM_API_KEY`, `LLM_BASE_URL`, and `LLM_MODEL_NAME` above.
GRAPHITI_LLM_BASE_URL=
GRAPHITI_LLM_API_KEY=
GRAPHITI_LLM_MODEL=
GRAPHITI_LLM_SMALL_MODEL=

# If your main chat endpoint does not serve embeddings, point these at a dedicated embedding endpoint.
GRAPHITI_EMBEDDER_BASE_URL=
GRAPHITI_EMBEDDER_API_KEY=
GRAPHITI_EMBEDDING_MODEL=bge-large-en-v1.5
GRAPHITI_EMBEDDER_TIMEOUT_SECONDS=120
GRAPHITI_EMBEDDER_MAX_RETRIES=3
GRAPHITI_EMBEDDER_MAX_CONCURRENCY=2

# `rrf` is the safest default with mixed OpenAI-compatible providers.
GRAPHITI_RERANKER_BASE_URL=
GRAPHITI_RERANKER_API_KEY=
GRAPHITI_RERANKER_MODEL=
GRAPHITI_SEARCH_RERANKER=rrf

# ===== Optional boosted LLM configuration =====
# Leave these blank unless you have a second LLM endpoint for other workloads.
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=
LLM_BOOST_MODEL_NAME=
