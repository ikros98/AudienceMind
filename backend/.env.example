PERSONAGRAPH_DATABASE_URL=sqlite:///./personagraph.db
PERSONAGRAPH_DATA_DIR=./data
PERSONAGRAPH_ALLOWED_ORIGINS=http://localhost:3020,http://127.0.0.1:3020
PERSONAGRAPH_ENV=development
PERSONAGRAPH_LLM_PROVIDER=openai-compatible
PERSONAGRAPH_LLM_BASE_URL=https://openrouter.ai/api/v1
PERSONAGRAPH_LLM_API_KEY=your_openrouter_api_key_here
PERSONAGRAPH_LLM_MODEL=qwen/qwen3.6-plus:free
PERSONAGRAPH_GRAPH_BACKEND=graphiti
PERSONAGRAPH_SIMULATION_BACKEND=native
PERSONAGRAPH_REPORT_BACKEND=native
PERSONAGRAPH_EMBED_WORKFLOW_RUNNER=true
PERSONAGRAPH_WORKFLOW_POLL_INTERVAL_SECONDS=0.25
